+    .createWaferCadV2ViewPanels()
+    .update(
+      'mask',
+      { class: 'p-view', id: 'maskPanel', 'data-view': 'mask', 'aria-label': 'Mask view' },
+      el('header', { class: 'p-panel-head p-view-head' }, el('strong', {}, 'Mask'), tools),
