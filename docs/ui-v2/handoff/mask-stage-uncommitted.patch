diff --git a/site/tests/mask-view-adapter.test.mjs b/site/tests/mask-view-adapter.test.mjs
new file mode 100644
index 00000000..5b1b4cb2
--- /dev/null
+++ b/site/tests/mask-view-adapter.test.mjs
@@ -0,0 +1,105 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { loadGeometryKernel } from '../../scripts/process-benchmarks.mjs';
+
+await loadGeometryKernel();
+const { createDrawMaskController } = await import('../controllers/draw-mask-controller.js');
+const { createMaskRoiController } = await import('../controllers/mask-roi-controller.js');
+
+test('Mask public ports use optional v2 callbacks without constructing controller UI', () => {
+  let mask = {
+      nextShapeId: 3,
+      shapes: [
+        { id: 'shape-1', type: 'rect', a: [0, 0], b: [4, 2] },
+        { id: 'shape-2', type: 'circle', c: [8, 0], r: 1 },
+      ],
+    },
+    mode = 'draw',
+    summary = 0;
+  const events = [],
+    sync = [],
+    fields = new Map([
+      ['drawShapeCx', { value: '2.0001' }],
+      ['drawShapeCy', { value: '1' }],
+      ['drawShapeWidth', { value: '4' }],
+      ['drawShapeHeight', { value: '2' }],
+    ]);
+  const controller = createDrawMaskController({
+    root: {
+      getElementById: (id) => fields.get(id),
+      createElement: () => {
+        throw Error('Controller must not build v2 UI');
+      },
+    },
+    getMode: () => mode,
+    setMode: (value) => {
+      mode = value;
+    },
+    getDrawMask: () => mask,
+    setDrawMask: (value) => {
+      mask = value;
+    },
+    manualMicron: Number,
+    renderMask: () => {},
+    status: () => {},
+    onUiSync: (value) => sync.push(value),
+    onEditorSync: (kind, shape) => events.push({ kind, shape }),
+    syncSourceSummary: () => {
+      summary++;
+    },
+  });
+  controller.openEditor(mask.shapes[0]);
+  assert.equal(controller.getSelectedId(), 'shape-1');
+  assert.equal(events[0].kind, 'open');
+  controller.applyEditor();
+  assert.equal(mask.shapes[0].id, 'shape-1');
+  assert.ok(Math.abs(mask.shapes[0].a[0] - 0.0001) < 1e-12);
+  controller.removeSelected();
+  assert.deepEqual(
+    mask.shapes.map((shape) => shape.id),
+    ['shape-2'],
+  );
+  assert.equal(sync.at(-1).selected, null);
+  controller.setTool('polygon');
+  assert.equal(controller.getTool(), 'polygon');
+  const before = structuredClone(mask);
+  controller.setSourceMode('file');
+  assert.equal(mode, 'file');
+  assert.deepEqual(mask, before);
+  assert.equal(summary, sync.length);
+});
+
+test('Legacy Mask defaults retain source/toolbar sync; ROI callback is opt-in', () => {
+  const nodes = new Map([
+    ['drawMaskToolbar', {}],
+    ['maskFileControls', {}],
+    ['maskDrawInfo', {}],
+    ['maskSourceToggleBtn', {}],
+    ['drawShapeEditor', {}],
+    ['drawMaskDeleteBtn', {}],
+    ['drawMaskClearBtn', {}],
+  ]);
+  createDrawMaskController({
+    root: { getElementById: (id) => nodes.get(id), querySelectorAll: () => [] },
+    getMode: () => 'draw',
+    getDrawMask: () => ({ nextShapeId: 1, shapes: [] }),
+  }).syncUi();
+  assert.equal(nodes.get('drawMaskToolbar').hidden, false);
+  assert.equal(nodes.get('maskFileControls').hidden, true);
+  assert.equal(nodes.get('drawMaskDeleteBtn').disabled, true);
+  assert.equal(nodes.get('drawMaskClearBtn').disabled, true);
+  const roi = { type: 'circle', c: [1, 2], r: 3 };
+  let received;
+  createMaskRoiController({
+    root: {
+      getElementById: () => {
+        throw Error('v2 callback owns fields');
+      },
+    },
+    getRoi: () => roi,
+    onEditorSync: (value) => {
+      received = value;
+    },
+  }).syncEditor();
+  assert.equal(received, roi);
+});
diff --git a/site/ui-v2/mask-runtime.js b/site/ui-v2/mask-runtime.js
new file mode 100644
index 00000000..c57044bb
--- /dev/null
+++ b/site/ui-v2/mask-runtime.js
@@ -0,0 +1,227 @@
+// Mask-only controller injection. UI hooks are newly built v2 nodes, never legacy markup.
+import { createPlanViewController } from '../controllers/plan-view-controller.js';
+import { createPlanRenderers } from '../plan-renderers.js';
+import { createDrawMaskController } from '../controllers/draw-mask-controller.js';
+import { createMaskRoiController } from '../controllers/mask-roi-controller.js';
+import { createMaskImportController } from '../controllers/mask-import-controller.js';
+import { createExportController } from '../controllers/export-controller.js';
+import { maskLocalToWorld } from '../mask-roi-geometry.js';
+import { drawShapeContainsPoint } from '../draw-mask-geometry.js';
+import { formatInspectionLength } from './view-kit/inspection-fields.js';
+import { bindPlanGestures } from './view-kit/plan-gestures.js';
+
+export function createMaskRuntime({
+  state,
+  root,
+  onChange,
+  onEditorSync,
+  onRoiSync,
+  status,
+  confirmAction,
+}) {
+  let renderer,
+    draw,
+    roi,
+    exporting = false;
+  const renderMask = () => {
+    renderer?.renderMask();
+    roi?.syncEditor();
+    onChange();
+  };
+  const lengths = {
+    xyUnitLabel: () => 'µm',
+    formatLengthField: formatInspectionLength,
+    formatNumericField: (value) => String(value),
+    manualMicron: Number,
+    xyText: (value) => `${formatInspectionLength(value)} µm`,
+  };
+  const maskPoint = (point) => maskLocalToWorld(point, state.maskTransform);
+  const layerKey = (layer, datatype) => `${layer}|${datatype}`;
+  // Same stable presentation palette as the legacy Mask; no geometry or layer ownership changes.
+  const palette = [
+    '#4F86C6',
+    '#4FAF9F',
+    '#E6A23C',
+    '#D96C5F',
+    '#8A72BE',
+    '#57A6C7',
+    '#6C8E5E',
+    '#C5678B',
+  ];
+  const layerColor = (key, alpha = 1) => {
+    let hash = 0;
+    for (const ch of key) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
+    const hex = palette[hash % palette.length],
+      value = parseInt(hex.slice(1), 16);
+    return alpha >= 0.999
+      ? hex
+      : `rgba(${value >> 16},${(value >> 8) & 255},${value & 255},${alpha})`;
+  };
+  const selectedElement = (element) =>
+    state.selectedLayerKeys.includes(layerKey(element.layer, element.datatype));
+  const plan = createPlanViewController({
+    getModel: () => state.model,
+    getLayout: () => state.layout,
+    getMaskTransform: () => state.maskTransform,
+    getMaskSourceMode: () => state.maskSourceMode,
+    getDrawMask: () => state.drawMask,
+    getPlanViews: () => state.planViews,
+    maskPoint,
+    formatXY: formatInspectionLength,
+    xyToDisplay: Number,
+    xyFromDisplay: Number,
+    xyUnitLabel: lengths.xyUnitLabel,
+    renderMask,
+    renderMain: () => {},
+  });
+  draw = createDrawMaskController({
+    root,
+    getMode: () => state.maskSourceMode,
+    setMode: (value) => {
+      state.maskSourceMode = value;
+    },
+    getDrawMask: () => state.drawMask,
+    setDrawMask: (value) => {
+      state.drawMask = value;
+    },
+    ...plan,
+    ...lengths,
+    renderMask,
+    status,
+    confirmAction,
+    isInteractionBlocked: () => state.panEnabled || Boolean(state.maskRoiTool) || !state.drawOpen,
+    onUiSync: (value) => {
+      state.drawUi = value;
+      onChange();
+    },
+    onEditorSync,
+  });
+  roi = createMaskRoiController({
+    root,
+    getRoi: () => state.maskRoi,
+    setRoi: (value) => {
+      state.maskRoi = value;
+    },
+    getTool: () => state.maskRoiTool,
+    setTool: (value) => {
+      state.maskRoiTool = value;
+    },
+    getDraft: () => state.maskRoiDraft,
+    setDraft: (value) => {
+      state.maskRoiDraft = value;
+    },
+    getAnchor: () => state.maskRoiAnchor,
+    setAnchor: (value) => {
+      state.maskRoiAnchor = value;
+    },
+    getTransform: () =>
+      state.maskSourceMode === 'file' ? state.maskTransform : { x: 0, y: 0, scale: 1, rotation: 0 },
+    canMoveBody: (point) =>
+      !draw.getTool() &&
+      !state.drawMask.shapes.some((shape) => drawShapeContainsPoint(shape, point)),
+    ...plan,
+    ...lengths,
+    renderMask,
+    status,
+    onEditorSync: onRoiSync,
+  });
+  renderer = createPlanRenderers({
+    root,
+    getState: () => state,
+    getDrawMaskController: () => draw,
+    getMaskRoiController: () => roi,
+    ...plan,
+    ...lengths,
+    formatXY: formatInspectionLength,
+    maskPoint,
+    layerKey,
+    layerColor,
+    selectedElement,
+  });
+  const canvas = root.getElementById('maskCanvas');
+  bindPlanGestures({
+    canvas,
+    mouse: true,
+    panEnabled: () => state.panEnabled,
+    zoomEnabled: () => state.zoomEnabled,
+    panBy: (dx, dy) => plan.panPlanView('mask', dx, dy),
+    zoomAt: (factor, x, y) => plan.zoomPlanView('mask', canvas, factor, x, y),
+  });
+  draw.bind();
+  roi.bind();
+  const alignment = createMaskImportController({
+    root,
+    getMaskTransform: () => state.maskTransform,
+    setMaskTransform: (value) => {
+      state.maskTransform = value;
+    },
+    ...lengths,
+    renderMask,
+    status,
+  });
+  const runMaskLayoutExport = (request) => {
+    if (exporting) {
+      status('Another Mask export is running.');
+      return Promise.resolve(null);
+    }
+    exporting = true;
+    return new Promise((resolve, reject) => {
+      const worker = new Worker(new URL('../layout-export-worker.js', import.meta.url));
+      const finish = (value, error) => {
+        worker.terminate();
+        exporting = false;
+        error ? reject(error) : resolve(value);
+      };
+      worker.onmessage = ({ data }) => {
+        if (data.type === 'progress') status(data.stage);
+        else if (data.type === 'done') finish(data);
+        else if (data.type === 'error') finish(null, Error(data.message));
+      };
+      worker.onerror = (event) => finish(null, Error(event.message));
+      worker.postMessage({ ...request, id: 'mask-review-export' });
+    });
+  };
+  const exporter = createExportController({
+    root,
+    getState: () => state,
+    ...plan,
+    maskPoint,
+    layerKey,
+    layerColor,
+    selectedElement,
+    formatXY: formatInspectionLength,
+    runMaskLayoutExport,
+    status,
+  });
+  renderMask();
+  return {
+    draw,
+    roi,
+    alignment,
+    exporter,
+    plan,
+    render: renderMask,
+    fit: () => plan.resetPlanView('mask'),
+    setPanEnabled(value) {
+      state.panEnabled = value;
+      renderMask();
+    },
+    setZoomEnabled(value) {
+      state.zoomEnabled = value;
+      renderMask();
+    },
+    chooseDrawTool(value) {
+      state.panEnabled = false;
+      roi.clearDrawingMode();
+      draw.setTool(value === 'select' ? null : value);
+    },
+    chooseRoiTool(value) {
+      state.panEnabled = false;
+      draw.setTool(null);
+      state.maskRoiTool = value;
+      state.maskRoiDraft = null;
+      renderMask();
+      status('Drag in Mask to create the ROI.');
+    },
+  };
+}
diff --git a/site/ui-v2/mask-view.js b/site/ui-v2/mask-view.js
new file mode 100644
index 00000000..d74ca057
--- /dev/null
+++ b/site/ui-v2/mask-view.js
@@ -0,0 +1,532 @@
+// Mask v2 presentation/config only. The existing controllers own shape/ROI operations.
+import { readProjectFile } from '../project-io.js';
+import { createMaskRuntime } from './mask-runtime.js';
+import { createFloatingStrip } from './view-kit/floating-strip.js';
+import { createFloatingEditorManager } from './view-kit/floating-editor.js';
+import { createInspectionFields, formatInspectionLength } from './view-kit/inspection-fields.js';
+import { maskRoiAnchorPoint } from '../mask-roi-geometry.js';
+
+const { el, button, toolbar, panelHeader } = window.WaferCadV2Components;
+const hooks = new Map();
+const hook = (id, node) => {
+  node.id = id;
+  hooks.set(id, node);
+  return node;
+};
+const root = {
+  getElementById: (id) => document.getElementById(id) || hooks.get(id),
+  createElement: (...args) => document.createElement(...args),
+  querySelectorAll: (...args) => document.querySelectorAll(...args),
+  get activeElement() {
+    return document.activeElement;
+  },
+  body: document.body,
+};
+const { input, choice, pair, textarea } = createInspectionFields({ hook });
+const source = 'site/examples/m3d-selfpowered-full-replay.wafercad';
+const expectedHash = '31f07d85c32d44685ef7f49485e432c2b73f713550dd981998376c61de46995b';
+let state,
+  shell,
+  overlays,
+  runtime,
+  strip,
+  message = 'Ready',
+  modelBefore,
+  editorShapeId;
+const uiState = {
+  layout: 'a',
+  font: 'inter',
+  domain: 'project',
+  mode: 'single',
+  view: 'mask',
+  section: false,
+  mobile: 'view',
+  splitViews: ['main', 'three'],
+  maximize: null,
+};
+const caption = () =>
+  `${state.maskSourceMode === 'draw' ? `${state.drawMask.shapes.length} drawn shapes` : `${state.layout.elements.length} File elements`} · µm`;
+const iconButton = (hint, action, glyph, extra = {}) =>
+  button('', action, glyph, { title: hint, 'aria-label': hint, ...extra });
+function sync() {
+  if (!state) return;
+  strip?.update({ open: state.drawOpen, selected: state.drawUi?.tool || 'select' });
+  for (const key of ['pan', 'zoom'])
+    document
+      .querySelector(`[data-action="tool:${key}:mask"]`)
+      ?.setAttribute('aria-pressed', String(state[`${key}Enabled`]));
+  root.getElementById('maskCanvas')?.classList.toggle('plan-pan-active', state.panEnabled);
+  shell?.getSlot('view.mask.readout')?.replaceChildren(caption());
+  shell?.getSlot('status.message')?.replaceChildren(message);
+  if (hooks.has('maskSourceToggleBtn'))
+    hooks.get('maskSourceToggleBtn').value = state.maskSourceMode;
+}
+function shapeFields(shape) {
+  if (shape.type === 'polygon')
+    return [
+      [
+        'Points · µm (one x, y pair per line)',
+        'drawShapePoints',
+        shape.points.map((p) => p.map(formatInspectionLength).join(', ')).join('\n'),
+        'points',
+      ],
+    ];
+  const center = shape.type === 'rect' ? shape.a.map((v, i) => (v + shape.b[i]) / 2) : shape.c;
+  const fields = [
+    ['X · µm', 'drawShapeCx', center[0]],
+    ['Y · µm', 'drawShapeCy', center[1]],
+  ];
+  if (shape.type === 'rect')
+    fields.push(
+      ['Width · µm', 'drawShapeWidth', shape.b[0] - shape.a[0]],
+      ['Height · µm', 'drawShapeHeight', shape.b[1] - shape.a[1]],
+    );
+  else if (shape.type === 'circle') fields.push(['Radius · µm', 'drawShapeRadius', shape.r]);
+  else
+    fields.push(
+      ['Inner radius · µm', 'drawShapeInnerRadius', shape.innerR],
+      ['Outer radius · µm', 'drawShapeOuterRadius', shape.outerR],
+    );
+  if (shape.type === 'ring-sector')
+    fields.push(
+      ['Start angle · °', 'drawShapeStartDeg', shape.startDeg, 'angle'],
+      ['End angle · °', 'drawShapeEndDeg', shape.endDeg, 'angle'],
+    );
+  return fields;
+}
+function editorSync(kind, shape) {
+  if (kind === 'close') {
+    overlays?.closeFloating('maskDrawSettings', 'hidden');
+    hooks.get('drawShapeEditor').hidden = true;
+    editorShapeId = null;
+    return;
+  }
+  if (!shape || (kind !== 'open' && !overlays.hasFloating('maskDrawSettings'))) return;
+  if (kind === 'open') {
+    if (overlays.hasFloating('maskDrawSettings'))
+      overlays.closeFloating('maskDrawSettings', 'hidden');
