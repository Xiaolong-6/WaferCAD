{
  "name": "wafercad",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node site/selftest.mjs && node --test site/tests/*.test.mjs",
    "lint": "eslint \"site/**/*.{js,mjs}\"",
    "format": "prettier --write \"site/**/*.{js,mjs,css,html}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"site/**/*.{js,mjs,css,html}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"README.md\" \"THIRD_PARTY_NOTICES.md\" \"eslint.config.js\" \"package.json\" \".prettierrc.json\"",
    "check": "npm run lint && npm run format:check && npm test",
    "check:ci": "npm run lint && npm test",
    "precommit": "npm run format && npm run lint && npm test",
    "test:ui:smoke": "node scripts/ui-smoke.mjs",
    "test:ui:examples": "node scripts/example-regression.mjs",
    "test:ui:product": "npm run test:ui:product:layout && npm run test:ui:product:renderer",
    "test:ui:all": "npm run test:ui:smoke && npm run test:ui:workstation && npm run test:ui:history && npm run test:ui:persistence && npm run test:ui:process && npm run test:ui:interaction && npm run test:ui:resilience && npm run test:ui:examples && npm run test:ui:product",
    "test:ui:history": "node scripts/history-regression.mjs",
    "test:ui:persistence": "node scripts/persistence-regression.mjs",
    "test:ui:process": "node scripts/process-geometry-regression.mjs",
    "test:ui:workstation": "node scripts/workstation-regression.mjs",
    "test:ui:interaction": "node scripts/interaction-regression.mjs",
    "test:ui:resilience": "node scripts/resilience-regression.mjs",
    "test:ui:product:layout": "node scripts/product-layout-regression.mjs",
    "test:ui:product:renderer": "node scripts/renderer-product-regression.mjs"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.9"
  }
}
