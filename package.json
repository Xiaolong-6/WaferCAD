{
  "name": "wafercad",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node site/selftest.mjs",
    "lint": "eslint site/*.js site/*.mjs",
    "format": "prettier --write \"site/**/*.{js,mjs,css,html}\" \"docs/**/*.md\" \"*.md\" \"*.json\" \"*.yml\"",
    "format:check": "prettier --check \"site/**/*.{js,mjs,css,html}\" \"docs/**/*.md\" \"README.md\" \"THIRD_PARTY_NOTICES.md\" \"eslint.config.js\" \"package.json\" \".prettierrc.json\" \".github/workflows/*.yml\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.9"
  }
}
